{
  "name": "loomy-cli",
  "version": "0.1.0",
  "description": "Loomy gateway CLI",
  "private": false,
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "loomy": "bin/loomy.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.0",
  "files": [
    "dist",
    "bin",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm copy:assets",
    "copy:assets": "rm -rf dist/assets && cp -R assets dist/assets",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "woic",
  "license": "ISC",
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ink": "^7.0.2",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.6",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/uuid": "^11.0.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
